# Normalise line endings to LF in the repo, checkout as-is on all platforms
* text=auto eol=lf
*.py text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.env.example text eol=lf

# Binary files — never touch line endings
*.db binary
*.sqlite binary
*.pkl binary
*.png binary
*.jpg binary
