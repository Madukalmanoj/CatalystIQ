# Copy this file's contents into Streamlit Cloud → App settings → Secrets
# Do NOT commit the real secrets.toml — it is in .gitignore

MP_API_KEY = "your_materials_project_api_key"
BRENDA_EMAIL = "your_brenda_email"
BRENDA_PASSWORD = "your_brenda_password"
S2_API_KEY = ""          # optional — Semantic Scholar
OCP_DATA_DIR = "./data"
CACHE_DB_PATH = "./query_cache.sqlite"
DATABASE_URL = "sqlite:///catalystiq.db"
LOG_LEVEL = "INFO"
